# ─── Core ───────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# SQLite path (optional — defaults to backend/gracegifthub.db)
# DB_PATH=/home/yourusername/gracegifthub/backend/gracegifthub.db

# ─── Admin Credentials ──────────────────────────────────────────────────────
# Set these before first run. After first startup the hashed password is
# stored in the database. You can change it later via Settings → Account.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234

# ─── Payscribe Payment Gateway ──────────────────────────────────────────────
# Used for BOTH checkout and wallet funding. Flutterwave has been fully
# retired from this app.
PAYSCRIBE_API_KEY=pk_live_or_pk_test_your_api_key
PAYSCRIBE_BASE_URL=https://api.payscribe.com/v1
PAYSCRIBE_WEBHOOK_SECRET=ps_live_or_ps_test_your_webhook_secret

# ─── Product catalog provider ───────────────────────────────────────────────
# TopGiftCard / TP Gifts Store has been removed. Leave these unset to serve
# local sample products, or point them at a new provider (same X-API-KEY
# header convention as before — see routes/product_api_client.py).
PRODUCT_API_KEY=
PRODUCT_API_BASE_URL=

# ─── SMTP / Gmail ───────────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your normal Gmail password).
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=Gracegifthub
